<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Background -->
    <ImageView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:src="@drawable/backgroung"
        android:clickable="false"
        android:focusable="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Card -->
    <androidx.cardview.widget.CardView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="20dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="14dp"
        app:cardUseCompatPadding="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp"
                android:gravity="center_horizontal">

                <!-- Logo -->
                <ImageView
                    android:layout_width="95dp"
                    android:layout_height="95dp"
                    android:layout_marginBottom="10dp"
                    android:src="@drawable/logo"/>

                <!-- Title -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Add Food Details"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="#222222"
                    android:gravity="center"
                    android:layout_marginBottom="18dp"/>

                <!-- Inputs -->
                <EditText
                    android:id="@+id/foodName"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:hint="Food Name"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:background="@drawable/rounded_input"
                    android:layout_marginBottom="10dp"/>

                <EditText
                    android:id="@+id/quantity"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:hint="Quantity"
                    android:inputType="number"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:background="@drawable/rounded_input"
                    android:layout_marginBottom="10dp"/>

                <EditText
                    android:id="@+id/expiryDate"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:hint="Expiry Date"
                    android:focusable="false"
                    android:clickable="true"
                    android:cursorVisible="false"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:background="@drawable/rounded_input"
                    android:layout_marginBottom="10dp"/>

                <Spinner
                    android:id="@+id/foodTypeSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/rounded_input"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:entries="@array/options"
                    android:layout_marginBottom="10dp"/>

                <EditText
                    android:id="@+id/description"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:hint="Description"
                    android:gravity="top"
                    android:minLines="3"
                    android:padding="14dp"
                    android:background="@drawable/rounded_input"
                    android:layout_marginBottom="10dp"/>

                <EditText
                    android:id="@+id/location"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:hint="Pickup Location"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:background="@drawable/rounded_input"
                    android:layout_marginBottom="12dp"/>

                <!-- Buttons -->
                <Button
                    android:id="@+id/uploadImageButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Upload Food Image"
                    android:textAllCaps="false"
                    android:textSize="15sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#757575"
                    android:layout_marginBottom="10dp"/>

                <ImageView
                    android:id="@+id/foodImagePreview"
                    android:layout_width="170dp"
                    android:layout_height="170dp"
                    android:visibility="gone"
                    android:scaleType="centerCrop"
                    android:background="#EEEEEE"
                    android:layout_marginBottom="14dp"/>

                <Button
                    android:id="@+id/submitFoodButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Submit Food"
                    android:textAllCaps="false"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#FF7043"/>

            </LinearLayout>

        </ScrollView>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>